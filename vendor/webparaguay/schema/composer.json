{
    "name": "webparaguay/schema",
    "description": "Contrato JSON de un sitio + validador. La única fuente de verdad (ADR-001).",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.2",
        "opis/json-schema": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Webparaguay\\Schema\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webparaguay\\Schema\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
