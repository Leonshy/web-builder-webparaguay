{
    "name": "webparaguay/provisioning",
    "description": "Capa de abstracción sobre WHMCS y Plesk. Nada del resto del sistema llama a esas APIs directamente (ADR-001, regla 16 del CLAUDE.md).",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "Webparaguay\\Provisioning\\": "src/" } },
    "autoload-dev": { "psr-4": { "Webparaguay\\Provisioning\\Tests\\": "tests/" } },
    "scripts": { "test": "phpunit" },
    "config": { "sort-packages": true }
}
